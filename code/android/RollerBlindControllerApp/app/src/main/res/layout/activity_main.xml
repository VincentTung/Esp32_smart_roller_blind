<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/device_info_border"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_margin="5dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_device_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="设备名称: SmartRollerBlind"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_device_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="设备地址: D8:3B:DA:E6:BB:B2"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <include
            android:id="@+id/btn_reconnect"
            layout="@layout/button_centered_icon_text"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="5dp">

        <ImageView
            android:id="@+id/iv_gif"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="30dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/full_open" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- 大型升起按钮 -->
            <ImageView
                android:id="@+id/btn_curtain_up"
                android:layout_width="@dimen/direction_btn_width"
                android:layout_height="@dimen/direction_btn_height"
                android:layout_marginBottom="5dp"
                android:src="@drawable/up" />

            <!-- 中间控制行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_curtain_left"
                    android:layout_width="@dimen/direction_btn_width"
                    android:layout_height="@dimen/direction_btn_height"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/smaller_up" />

                <ImageView
                    android:id="@+id/btn_curtain_stop"
                    android:layout_width="@dimen/direction_btn_width"
                    android:layout_height="@dimen/direction_btn_height"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/stop" />

                <ImageView
                    android:id="@+id/btn_curtain_right"
                    android:layout_width="@dimen/direction_btn_width"
                    android:layout_height="@dimen/direction_btn_height"
                    android:src="@drawable/smaller_down" />

            </LinearLayout>


            <ImageView
                android:id="@+id/btn_curtain_down"
                android:layout_width="@dimen/direction_btn_width"
                android:layout_height="@dimen/direction_btn_height"
                android:src="@drawable/down" />

        </LinearLayout>


    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/btn_curtain_set"
                layout="@layout/button_centered_icon_text"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <include
                android:id="@+id/btn_curtain_direction"
                layout="@layout/button_centered_icon_text"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>